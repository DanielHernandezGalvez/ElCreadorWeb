---
import "../styles/global.css";
import SEO from "../components/SEO.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "El Creador Web · Agencia Digital en México",
  description = "Creamos landing pages, tiendas online y sitios corporativos que convierten.",
  canonical,
  image,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
   <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-WYFS3XP9B4"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-WYFS3XP9B4');
</script>

   

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      noindex={noindex}
    />
    
  </head>

  <body class="bg-[#0E1620] text-[#FAFBFC] antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PC2CWJ2M"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <slot />
  </body>
</html>
