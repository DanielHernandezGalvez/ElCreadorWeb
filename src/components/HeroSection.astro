          </div>
          <div class="hero-browser-body">
            <div class="hero-line w-1/3 h-2"></div>
            <div class="hero-line w-5/6 h-3 mt-4"></div>
            <div class="hero-line w-2/3 h-3 mt-2"></div>
            <div class="hero-cta mt-5"></div>
            <div class="hero-content-grid mt-7">
              <div class="hero-content-block"></div>
              <div class="hero-content-block"></div>
              <div class="hero-content-block"></div>
            </div>
          </div>
        </div>

        <div class="hero-tag" data-reveal data-reveal-delay="2">&lt;/&gt;</div>
      </div>
    </div>
