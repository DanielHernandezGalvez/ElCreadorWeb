<section id="inicio" class="relative min-h-[86vh] flex items-center pt-28 pb-16 overflow-hidden">
  <div class="max-w-content mx-auto px-6 lg:px-8 w-full">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-14 lg:gap-10 items-center">
      <div class="max-w-xl" data-reveal>
        <p class="eyebrow mb-5">Diseño &amp; desarrollo web</p>
        <h1 class="font-display font-800 text-[2.6rem] leading-[1.08] sm:text-6xl sm:leading-[1.06] tracking-tight text-ink">
          Páginas web profesionales que ayudan a tu negocio a crecer
        </h1>
        <p class="mt-6 text-lg text-inksoft leading-relaxed">
