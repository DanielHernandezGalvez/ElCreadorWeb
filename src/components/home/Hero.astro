<section
  class="relative flex min-h-screen items-center justify-center overflow-hidden bg-[#0E1620] pt-10"
>
  <!-- Fondo -->
  <div
    class="absolute inset-0 opacity-40"
    aria-hidden="true"
  >
    <div
      class="absolute inset-0"
      style="
        background-image:
          linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
        background-size: 60px 60px;
      "
    ></div>
  </div>

  <!-- Resplandor -->
  <div
    class="absolute left-1/2 top-1/3 h-96 w-96 -translate-x-1/2 rounded-full bg-[#E7D117]/10 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="hero-scene absolute inset-0 overflow-hidden" data-hero-scene aria-hidden="true">
    <div class="float-ring left-[-5%] top-[5%] h-95 w-95" data-parallax></div>
    <div class="float-ring bottom-[10%] right-[-3%] h-70 w-70" data-parallax></div>
    <div class="float-ring right-[15%] top-[20%] h-45 w-45" data-parallax></div>
    <div class="float-square left-[20%] top-[15%] h-20 w-20" data-parallax data-rotate="15"></div>
    <div class="float-square bottom-[25%] left-[10%] h-12.5 w-12.5" data-parallax data-rotate="45"></div>
    <div class="float-square right-[25%] top-[60%] h-15 w-15" data-parallax data-rotate="30"></div>
    <div class="float-dot left-[40%] top-[30%] h-2 w-2" data-parallax></div>
    <div class="float-dot bottom-[35%] right-[15%] h-3 w-3" data-parallax></div>
    <div class="float-dot left-[25%] top-[70%] h-1.5 w-1.5" data-parallax></div>
    <div class="float-dot right-[35%] top-[10%] h-2.5 w-2.5" data-parallax></div>
    <div class="particle left-[10%] top-[20%] h-30 w-30"></div>
    <div class="particle bottom-[30%] right-[8%] h-20 w-20 [animation-delay:2s]"></div>
    <div class="particle left-[70%] top-[50%] h-37.5 w-37.5 [animation-delay:4s]"></div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-6xl px-6 pb-20 pt-32 text-center">
    <div class="mx-auto max-w-4xl">

      <div
        class="mb-6 inline-flex items-center rounded-full border border-[#E7D117]/30 bg-[#E7D117]/5 px-4 py-2 text-sm text-[#F5E98A]"
      >
        <span class="mr-2 h-2 w-2 rounded-full bg-[#E7D117]"></span>
        Sistemas especializados en conversión
      </div>

      <h1
        class="mx-auto max-w-4xl text-5xl font-bold leading-[1.05] tracking-tight md:text-7xl"
      >
        Diseñamos el
        <span class="text-[#E7D117]"> futuro digital</span>
        de tu negocio
      </h1>

      <p
        class="mt-8 max-w-2xl text-lg leading-8 text-white/65 md:text-xl mx-auto"
      >
        Landing pages, tiendas online y sitios corporativos que no solo
        se ven bien, generan resultados.
      </p>

      <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="#servicios"
          class="rounded-full bg-[#E7D117] px-7 py-3.5 text-center font-semibold text-[#0E1620] transition hover:bg-[#F3DE4A]"
        >
          Ver servicios
        </a>

        <a
          href="#proyectos"
          class="rounded-full border border-[#E7D117]/50 px-7 py-3.5 text-center font-semibold text-[#E7D117] transition hover:bg-[#E7D117]/10"
        >
          Ver proyectos
        </a>
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm text-white/50">
        <span>✓ Sin complejidades</span>
        <span>✓ Proceso claro</span>
        <span>✓ Diseño personalizado</span>
        <span>✓ Soporte</span>
      </div>

    </div>
  </div>
</section>

<style>
  .float-ring,
  .float-square,
  .float-dot {
    pointer-events: none;
    position: absolute;
    transition: transform 0.08s ease-out;
    will-change: transform;
  }

  .float-ring {
    border: 1px solid rgb(231 209 23 / 0.15);
    border-radius: 9999px;
  }

  .float-square {
    border: 1px solid rgb(231 209 23 / 0.12);
  }

  .float-dot {
    background: #e7d117;
    border-radius: 9999px;
    opacity: 0.4;
  }

  .particle {
    animation: float-particle 12s ease-in-out infinite;
    background: rgb(231 209 23 / 0.08);
    border-radius: 9999px;
    pointer-events: none;
    position: absolute;
  }

  @keyframes float-particle {
    0%, 100% { opacity: 0.3; transform: translate(0, 0) scale(1); }
    25% { opacity: 0.6; transform: translate(30px, -40px) scale(1.2); }
    50% { opacity: 0.4; transform: translate(-20px, -80px) scale(0.8); }
    75% { opacity: 0.7; transform: translate(40px, -30px) scale(1.1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .particle { animation: none; }
    .float-ring,
    .float-square,
    .float-dot { transition: none; }
  }
</style>

<script>
  const scene = document.querySelector<HTMLElement>("[data-hero-scene]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (scene && !reducedMotion.matches) {
    const elements = Array.from(scene.querySelectorAll<HTMLElement>("[data-parallax]"));
    const factors = [
      { x: 0.04, y: 0.04 }, { x: -0.03, y: 0.05 }, { x: 0.05, y: -0.03 },
      { x: -0.02, y: 0.06 }, { x: 0.06, y: -0.02 }, { x: -0.04, y: -0.04 },
      { x: 0.03, y: -0.05 }, { x: -0.05, y: 0.03 }, { x: 0.07, y: 0.02 },
      { x: -0.02, y: -0.06 },
    ];
    let animationFrame: number | undefined;

    const moveElements = (clientX: number, clientY: number) => {
      if (animationFrame) return;

      animationFrame = requestAnimationFrame(() => {
        const x = (clientX / window.innerWidth - 0.5) * 2;
        const y = (clientY / window.innerHeight - 0.5) * 2;

        elements.forEach((element, index) => {
          const factor = factors[index];
          const rotation = element.dataset.rotate ?? "0";
          element.style.transform = `translate(${x * factor.x * 60}px, ${y * factor.y * 60}px) rotate(${rotation}deg) rotateX(${y * 2}deg) rotateY(${x * 2}deg)`;
        });

        animationFrame = undefined;
      });
    };

    const resetElements = () => {
      elements.forEach((element) => {
        element.style.transitionDuration = "0.6s";
        element.style.transform = `translate(0, 0) rotate(${element.dataset.rotate ?? "0"}deg)`;
      });
    };

    scene.addEventListener("pointermove", (event) => {
      elements.forEach((element) => { element.style.transitionDuration = "0.08s"; });
      moveElements(event.clientX, event.clientY);
    });
    scene.addEventListener("pointerleave", resetElements);
  }
</script>