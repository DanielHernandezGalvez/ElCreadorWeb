---
import { getCollection, type CollectionEntry } from "astro:content";

// Fetch latest 3 non-draft posts
const postsRaw = await getCollection("blog", (entry: CollectionEntry<"blog">) => !entry.data.draft);

type PostItem = {
  id: string;
  title?: string;
  description?: string;
  pubDate?: string | number | Date;
  category?: string;
  thumbnail?: string;
};

const posts = postsRaw
  .map((p: CollectionEntry<"blog">): PostItem => ({ id: p.id, ...p.data }))
  .sort((a: PostItem, b: PostItem) => new Date(b.pubDate || 0).getTime() - new Date(a.pubDate || 0).getTime())
  .slice(0, 3);
---

<section id="blog-home" aria-labelledby="blog-home-title" class="bg-[#0E1620] py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl mx-auto">
        <span class="mx-auto flex w-fit rounded-full border border-[#E7D117]/30 bg-[#E7D117]/5 px-4 py-2 text-sm font-medium text-[#F5E98A]">Blog</span>

        <h2 id="blog-home-title" class="mt-6 text-4xl font-bold tracking-tight md:text-5xl text-center">
          Últimos artículos
          <span class="text-[#E7D117]"> del blog</span>
        </h2>

        <p class="mt-6 text-lg leading-8 text-white/55 text-center">
          Aprende con guías prácticas, casos y consejos para tu presencia digital.
        </p>
      </div>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {
        posts.map((post: PostItem) => (
          <article class="group overflow-hidden rounded-3xl border border-white/10 bg-[#19232F]">
            <a href={`/blog/${post.id}/`} class="relative block aspect-16/10 overflow-hidden">
              <img src={post.thumbnail} alt={post.title} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-[#0E1620]/0 transition duration-300 group-hover:bg-[#0E1620]/30"></div>
            </a>

            <div class="p-7">
              <p class="text-sm font-medium text-[#E7D117]">{post.category}</p>
              <h3 class="mt-2 text-2xl font-bold text-white">{post.title}</h3>
              <p class="mt-4 text-sm leading-7 text-white/55">{post.description}</p>
              <a href={`/blog/${post.id}/`} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[#E7D117] transition hover:gap-3">Leer artículo <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 border-t border-white/10 pt-10">
      <div class="max-w-2xl flex flex-col items-center mx-auto">
        <a href="/blog/" class="inline-flex w-fit items-center rounded-full border border-white/20 px-5 py-3 my-5 text-sm font-semibold text-white transition hover:border-[#E7D117] hover:text-[#E7D117]">Ver todos los artículos</a>
      </div>
    </div>
  </div>
</section>
