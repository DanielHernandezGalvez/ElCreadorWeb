<header class="fixed inset-x-0 top-0 z-50">
  <div class="mx-auto max-w-7xl px-4 py-3 sm:px-6 sm:py-4">
    <nav
      class="relative rounded-3xl border border-white/10 bg-[#0E1620]/80 px-5 py-3 backdrop-blur-md md:rounded-full"
      aria-label="Navegación principal"
    >
      <div class="flex items-center justify-between">
        <a href="/">
          <img src="/images/logo/logo.png" alt="El Creador Web" class="h-8 w-auto" transition:name="logo" />
        </a>

        <div class="hidden items-center gap-8 md:flex">
          <a href="/#servicios" class="text-sm text-white/70 transition hover:text-white">
            Servicios
          </a>

          <a href="/#proyectos" class="text-sm text-white/70 transition hover:text-white">
            Proyectos
          </a>

          <a href="/blog/" class="text-sm text-white/70 transition hover:text-white">
            Blog
          </a>

          <a href="/sobre-mi/" class="text-sm text-white/70 transition hover:text-white">
            Sobre mí
          </a>

          <a
            href="/contacto/"
            class="rounded-full bg-[#E7D117] px-5 py-2.5 text-sm font-semibold text-[#0E1620] transition hover:bg-[#F3DE4A]"
          >
            Contactar
          </a>
        </div>

        <button
          class="menu-toggle flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-white transition hover:border-[#E7D117] hover:text-[#E7D117] md:hidden"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú de navegación"
          data-menu-toggle
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

      <div id="mobile-menu" class="mobile-menu grid md:hidden" data-mobile-menu>
        <div class="overflow-hidden">
          <div class="border-t border-white/10 pb-2 pt-4 mt-4">
            <div class="flex flex-col gap-1">
              <a href="/#servicios" class="mobile-link">Servicios</a>
              <a href="/#proyectos" class="mobile-link">Proyectos</a>
              <a href="/blog/" class="mobile-link">Blog</a>
              <a href="/sobre-mi/" class="mobile-link">Sobre mí</a>
              <a href="/contacto/" class="mt-3 rounded-full bg-[#E7D117] px-5 py-3 text-center text-sm font-semibold text-[#0E1620] transition hover:bg-[#F3DE4A]">Contactar</a>
            </div>
          </div>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .menu-toggle span {
    background: currentColor;
    border-radius: 9999px;
    height: 2px;
    position: absolute;
    transition: transform 200ms ease, opacity 150ms ease;
    width: 18px;
  }

  .menu-toggle span:first-child { transform: translateY(-6px); }
  .menu-toggle span:last-child { transform: translateY(6px); }
  .menu-toggle[aria-expanded="true"] span:first-child { transform: rotate(45deg); }
  .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded="true"] span:last-child { transform: rotate(-45deg); }

  .mobile-menu {
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 250ms ease, opacity 200ms ease;
  }

  .mobile-menu[data-open="true"] {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .mobile-link {
    border-radius: 0.5rem;
    color: rgb(255 255 255 / 0.7);
    font-size: 0.875rem;
    padding: 0.75rem 1rem;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .mobile-link:hover { background: rgb(255 255 255 / 0.08); color: white; }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  const closeMenu = () => {
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Abrir menú de navegación");
    menu.dataset.open = "false";
  };

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Abrir menú de navegación" : "Cerrar menú de navegación");
    if (menu) menu.dataset.open = String(!isOpen);
  });

  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeMenu(); });
</script>