---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

// Load non-draft blog posts and sort by pubDate desc
const postsRaw = await getCollection("blog", (entry: CollectionEntry<"blog">) => {
  return entry.data.draft === false;
});

type PostItem = {
  id: string;
  title?: string;
  description?: string;
  pubDate?: string | number | Date;
  category?: string;
  thumbnail?: string;
};

const posts = postsRaw
  .map((p: CollectionEntry<"blog">): PostItem => ({
    id: p.id,
    ...p.data,
  }))
  .sort((a: PostItem, b: PostItem) => (new Date(b.pubDate || 0).getTime() - new Date(a.pubDate || 0).getTime()));
---

<BaseLayout
  title="Blog | El Creador Web"
  description="Artículos y recursos sobre diseño y desarrollo web."
  canonical="/blog/"
>
  <Header />

  <main>
    <!-- Hero (match proyectos design) -->
    <section
      class="relative flex min-h-[75vh] items-center justify-center overflow-hidden bg-[#0E1620] pt-10"
    >
      <!-- Grid -->
      <div
        class="absolute inset-0 opacity-40"
        aria-hidden="true"
      >
        <div
          class="absolute inset-0"
          style="background-image: linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px); background-size: 60px 60%;"
        ></div>
      </div>

      <!-- Glow -->
      <div
        class="absolute left-1/2 top-1/3 h-96 w-96 -translate-x-1/2 rounded-full bg-[#E7D117]/10 blur-3xl"
        aria-hidden="true"
      ></div>

      <!-- Elementos decorativos -->
      <div
        class="absolute inset-0 overflow-hidden"
        aria-hidden="true"
      >
        <div class="project-ring left-[-5%] top-[10%] h-80 w-80"></div>

        <div class="project-ring bottom-[5%] right-[-4%] h-64 w-64"></div>

        <div class="project-square right-[15%] top-[20%] h-16 w-16"></div>

        <div class="project-square bottom-[20%] left-[15%] h-10 w-10"></div>

        <div class="project-dot left-[35%] top-[25%] h-2 w-2"></div>

        <div class="project-dot bottom-[25%] right-[30%] h-3 w-3"></div>
      </div>

      <!-- Contenido -->
      <div
        class="relative z-10 mx-auto w-full max-w-6xl px-6 py-32 text-center"
      >
        <div class="mx-auto max-w-4xl">
          <div
            class="mb-6 inline-flex items-center rounded-full border border-[#E7D117]/30 bg-[#E7D117]/5 px-4 py-2 text-sm text-[#F5E98A]"
          >
            <span class="mr-2 h-2 w-2 rounded-full bg-[#E7D117]"></span>

            Blog
          </div>

          <h1
            class="mx-auto max-w-4xl text-5xl font-bold leading-[1.05] tracking-tight md:text-7xl"
          >
            Ideas y guías para
            <span class="text-[#E7D117]"> crecer en línea</span>
          </h1>

          <p
            class="mx-auto mt-8 max-w-2xl text-lg leading-8 text-white/65 md:text-xl"
          >
            Publicaciones sobre diseño, desarrollo y estrategia digital.
          </p>

          <div class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm text-white/50">
            <span>✓ Diseño centrado</span>
            <span>✓ Desarrollo práctico</span>
            <span>✓ Enfoque en resultados</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Posts List -->
    <section class="bg-[#FAFBFC] py-24 text-[#0E1620]">
      <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-2xl">
          <span class="inline-flex rounded-full border border-[#E7D117] bg-[#E7D117]/10 px-4 py-2 text-sm font-medium">Artículos</span>

          <h2 class="mt-6 text-4xl font-bold tracking-tight md:text-5xl">Últimas publicaciones</h2>

          <p class="mt-6 text-lg leading-8 text-[#0E1620]/60">Explora tutoriales, casos y consejos prácticos para tu negocio en línea.</p>
        </div>

        <div class="mt-14 grid gap-8 lg:grid-cols-2">
          {
            posts.map((post: PostItem, index: number) => (
              <article
                class:list={[
                  "group overflow-hidden rounded-3xl border border-[#0E1620]/10 bg-white",
                  index === 0 && "lg:col-span-2",
                ]}
              >
                <a
                  href={`/blog/${post.id}/`}
                  class:list={[
                    "grid",
                    index === 0 ? "lg:grid-cols-2" : "md:grid-cols-2",
                  ]}
                >
                  <div class="relative aspect-16/10 overflow-hidden bg-[#19232F]">
                    <img
                      src={post.thumbnail}
                      alt={post.title}
                      loading={index === 0 ? "eager" : "lazy"}
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    />

                    <div class="absolute inset-0 bg-[#0E1620]/0 transition duration-300 group-hover:bg-[#0E1620]/20"></div>
                  </div>

                  <div class="flex flex-col justify-center p-8 md:p-10">
                    <div class="flex flex-wrap items-center gap-2 text-sm">
                      <span class="font-semibold text-[#C5A900]">{post.category}</span>

                      <span class="text-[#0E1620]/25">/</span>

                      <span class="text-[#0E1620]/45">{new Date(post.pubDate || 0).toLocaleDateString("es-MX", { day: "numeric", month: "long", year: "numeric" })}</span>
                    </div>

                    <h3 class="mt-4 text-3xl font-bold">{post.title}</h3>

                    <p class="mt-4 leading-7 text-[#0E1620]/60">{post.description}</p>

                    <span class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[#0E1620] transition-all group-hover:gap-3">
                      Leer artículo
                      <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[#E7D117] py-20 text-[#0E1620]">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl">¿Tienes un proyecto en mente?</h2>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-[#0E1620]/65">Podemos convertir tu idea en una experiencia digital profesional.</p>

        <a href="/contacto/" class="mt-8 inline-flex rounded-full bg-[#0E1620] px-7 py-3.5 font-semibold text-white transition hover:bg-[#19232F]">Hablemos de tu proyecto</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .project-ring,
  .project-square,
  .project-dot {
    position: absolute;
    pointer-events: none;
  }

  .project-ring {
    border: 1px solid rgb(231 209 23 / 0.12);
    border-radius: 9999px;
  }

  .project-square {
    border: 1px solid rgb(231 209 23 / 0.10);
    transform: rotate(25deg);
  }

  .project-dot {
    border-radius: 9999px;
    background: #e7d117;
    opacity: 0.35;
  }
</style>
