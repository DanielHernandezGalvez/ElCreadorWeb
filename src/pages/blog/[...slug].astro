---
import { getCollection, getEntry, render } from "astro:content" // replaced deprecated getEntryBySlug with getEntry
import type { CollectionEntry } from "astro:content" // import type for explicit typing of collection entries
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (entry: CollectionEntry<"blog">) => {
    return entry.data.draft === false; // keep only non-draft posts (typed entry to avoid implicit any)
  });

  return posts.map((post: CollectionEntry<"blog">) => ({
    params: {
      slug: post.id, // return only params (do not include full post in props)
    },
  }));
}

// Normalize slug (catch-all route can provide an array)
const params = Astro.params as Record<string, string | string[]>; // assert params shape so TS knows `slug` exists
const slug = Array.isArray(params.slug) ? params.slug.join("/") : (params.slug ?? ""); // ensure slug is a string (fallback to empty)

// Load the post at request-time / build-time per slug instead of serializing full `post` in getStaticPaths
const post = await getEntry("blog", slug); // fetch the collection entry by slug using `getEntry`
if (!post) {
  throw new Error(`Blog post not found: ${slug}`); // surface a clear error if the entry doesn't exist
}

// Render the post to a `Content` component. Pass the whole `post` entry so `render` receives the expected object
const { Content } = await render(post); // pass `post` (CollectionEntry) instead of a raw string

// Extract data and ensure pubDate is converted to a Date object
const {
  title,
  description,
  pubDate: rawPubDate,
  category,
  tags,
  thumbnail,
  author,
  youtubeId,
} = post.data; // destructure data from the loaded post

const pubDate = rawPubDate ? new Date(rawPubDate) : null; // convert pubDate to Date to safely call toLocaleDateString
const formattedPubDate = pubDate
  ? pubDate.toLocaleDateString("es-MX", {
      day: "numeric",
      month: "long",
      year: "numeric",
    })
  : ""; // pre-format date and fallback to empty string to avoid null usage in template
---

<BaseLayout
  title={`${title} | El Creador Web`}
  description={description}
  image={thumbnail}
  canonical={`/blog/${post.id}/`}
>
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden bg-[#0E1620] pt-32 pb-20">
      <div class="absolute inset-0 opacity-40" aria-hidden="true">
        <div
          class="absolute inset-0"
          style="
            background-image:
              linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
              linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
            background-size: 60px 60px;
          "
        ></div>
      </div>

      <div
        class="absolute left-1/2 top-1/2 h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#E7D117]/10 blur-3xl"
        aria-hidden="true"
      ></div>

      <div
        class="absolute left-[8%] top-[20%] h-32 w-32 rounded-full border border-[#E7D117]/10"
        aria-hidden="true"
      ></div>

      <div
        class="absolute bottom-[15%] right-[8%] h-20 w-20 rotate-12 border border-[#E7D117]/10"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
        <a
          href="/blog/"
          class="mb-8 inline-flex items-center gap-2 text-sm text-white/45 transition hover:text-[#E7D117]"
        >
          ← Volver al blog
        </a>

        <div
          class="mb-6 inline-flex items-center rounded-full border border-[#E7D117]/30 bg-[#E7D117]/5 px-4 py-2 text-sm text-[#F5E98A]"
        >
          <span class="mr-2 h-2 w-2 rounded-full bg-[#E7D117]"></span>
          {category}
        </div>

        <h1
          class="text-4xl font-bold leading-tight tracking-tight md:text-6xl"
        >
          {title}
        </h1>

        <p class="mx-auto mt-8 max-w-2xl text-lg leading-8 text-white/60">
          {description}
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-4 text-sm text-white/40">
          <span>{formattedPubDate}</span>

          <span>·</span>

          <span>{author}</span>
        </div>
      </div>
    </section>

    <!-- IMAGEN -->
    <section class="bg-[#FAFBFC] py-16">
      <div class="mx-auto max-w-5xl px-6">
        <div class="overflow-hidden rounded-3xl bg-white shadow-2xl">
          <img
            src={thumbnail}
            alt={title}
            class="block aspect-video w-full object-cover"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <!-- ARTÍCULO -->
    <section class="bg-[#FAFBFC] pb-24 text-[#0E1620]">
      <div class="mx-auto max-w-3xl px-6">
        <article class="blog-content">
          <Content />

          <!-- TAGS -->
          {
            tags.length > 0 && (
              <div class="mt-12 flex flex-wrap gap-2 border-t border-black/10 pt-8">
                {tags.map((tag: string) => (
                  <span class="rounded-full border border-black/10 px-3 py-1 text-sm text-black/50">
                    #{tag}
                  </span>
                ))}
              </div>
            )
          }
        </article>
      </div>
    </section>

    <!-- VIDEO -->
    {
      youtubeId && (
        <section class="bg-[#0E1620] py-24">
          <div class="mx-auto max-w-5xl px-6">
            <div class="mb-10 text-center">
              <p class="text-sm uppercase tracking-[0.2em] text-[#E7D117]">
                Video
              </p>

              <h2 class="mt-3 text-3xl font-bold md:text-4xl">
                Mira el contenido en video
              </h2>
            </div>

            <div class="aspect-video overflow-hidden rounded-3xl bg-black shadow-2xl">
              <iframe
                class="h-full w-full"
                src={`https://www.youtube.com/embed/${youtubeId}`}
                title={title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </section>
      )
    }

    <!-- CTA -->
    <section class="bg-[#FAFBFC] py-24 text-[#0E1620]">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <p class="text-sm uppercase tracking-[0.2em] text-[#B5A300]">
          ¿Tienes un proyecto?
        </p>

        <h2 class="mt-4 text-4xl font-bold md:text-5xl">
          Hagamos crecer tu negocio en internet
        </h2>

        <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-black/60">
          Cuéntame qué necesitas y encontremos la solución digital adecuada
          para tu negocio.
        </p>

        <a
          href="/contacto/"
          class="mt-8 inline-flex rounded-full bg-[#E7D117] px-7 py-3.5 font-semibold text-[#0E1620] transition hover:bg-[#F3DE4A]"
        >
          Hablemos de tu proyecto
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .blog-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 1.875rem;
    line-height: 1.2;
    font-weight: 700;
  }

  .blog-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.35rem;
    line-height: 1.3;
    font-weight: 700;
  }

  .blog-content :global(p) {
    margin-bottom: 1.25rem;
    color: rgb(14 22 32 / 0.65);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .blog-content :global(ul) {
    margin: 1.25rem 0;
    padding-left: 1.5rem;
    color: rgb(14 22 32 / 0.65);
  }

  .blog-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .blog-content :global(strong) {
    color: #0e1620;
    font-weight: 600;
  }

  .blog-content :global(a) {
    color: #8d8000;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>