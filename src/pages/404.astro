---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Página no encontrada · El Creador Web" description="La página que buscas no existe." canonical="/404/">
  <Header />

  <main>
    <section class="relative flex min-h-[70vh] items-center justify-center overflow-hidden bg-[#0E1620] py-24">
      <div class="absolute inset-0 opacity-40" aria-hidden="true">
        <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px); background-size: 60px 60px;"></div>
      </div>

      <!-- Animated illustration -->
      <div aria-hidden="true" class="absolute left-1/2 top-1/3 -translate-x-1/2 -translate-y-1/2 pointer-events-none">
        <svg width="520" height="320" viewBox="0 0 520 320" fill="none" xmlns="http://www.w3.org/2000/svg" class="animate-404-svg">
          <defs>
            <linearGradient id="g1" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#E7D117" stop-opacity="0.12" />
              <stop offset="100%" stop-color="#E7D117" stop-opacity="0.02" />
            </linearGradient>
          </defs>
          <g>
            <ellipse cx="120" cy="80" rx="110" ry="70" fill="url(#g1)" class="blob blob-1" />
            <ellipse cx="360" cy="220" rx="140" ry="90" fill="url(#g1)" class="blob blob-2" />
            <circle cx="420" cy="60" r="26" fill="#E7D117" opacity="0.08" class="dot dot-1" />
          </g>
        </svg>
      </div>

      <div class="relative z-10 mx-auto max-w-4xl px-6 text-center text-white">
        <h1 class="text-5xl font-bold md:text-6xl">404 — Página no encontrada</h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-white/60">Lo sentimos, la página que buscas no existe o fue movida.</p>

        <div class="mt-10">
          <a href="/" class="inline-flex items-center gap-3 rounded-full bg-[#E7D117] px-6 py-3 font-semibold text-[#0E1620] hover:bg-[#F3DE4A]">Volver al inicio</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .animate-404-svg { filter: blur(18px); }

  @keyframes float-1 {
    0% { transform: translateY(0) translateX(0) scale(1); }
    50% { transform: translateY(-8px) translateX(6px) scale(1.02); }
    100% { transform: translateY(0) translateX(0) scale(1); }
  }

  @keyframes float-2 {
    0% { transform: translateY(0) translateX(0) scale(1); }
    50% { transform: translateY(10px) translateX(-6px) scale(0.99); }
    100% { transform: translateY(0) translateX(0) scale(1); }
  }

  .blob-1 { animation: float-1 6s ease-in-out infinite; transform-origin: center; }
  .blob-2 { animation: float-2 7s ease-in-out infinite; transform-origin: center; }
  .dot-1 { animation: float-1 5s ease-in-out infinite; transform-origin: center; }
</style>
