---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const services = [
  {
    number: "01",
    title: "Landing Page",
    description:
      "Una página diseñada específicamente para presentar un producto, servicio, negocio u oferta y convertir visitantes en oportunidades.",
    price: "Desde $3,800 MXN",
    idealFor:
      "Ideal para campañas, profesionales, servicios y negocios que necesitan comenzar a generar presencia online.",
    features: [
      "Diseño personalizado",
      "Diseño responsive",
      "SEO básico",
      "Formulario de contacto",
      "Optimización de velocidad",
    ],
  },
  {
    number: "02",
    title: "Sitio Corporativo",
    description:
      "Un sitio web completo para comunicar quién eres, qué haces y por qué los clientes deberían elegirte.",
    price: "Desde $5,500 MXN",
    idealFor:
      "Ideal para empresas, profesionales y negocios que necesitan una presencia digital sólida.",
    features: [
      "Hasta 5 páginas",
      "Diseño personalizado",
      "Diseño responsive",
      "SEO básico",
      "Formulario de contacto",
      "Estructura escalable",
    ],
  },
  {
    number: "03",
    title: "Ecommerce",
    description:
      "Una tienda online preparada para presentar productos, gestionar un catálogo y facilitar el proceso de compra.",
    price: "Desde $7,000 MXN",
    idealFor:
      "Ideal para negocios que quieren comenzar o mejorar sus ventas por internet.",
    features: [
      "Catálogo de productos",
      "Carrito de compras",
      "Integración de pagos",
      "Diseño responsive",
      "Configuración inicial",
      "Gestión de productos",
    ],
  },
];
---

<BaseLayout
  title="Servicios de Diseño y Desarrollo Web | El Creador Web"
  description="Landing pages, sitios corporativos y tiendas online diseñadas y desarrolladas para negocios que quieren crecer en internet."
  canonical="/servicios/"
>
  <Header />

  <main>
 <!-- Hero -->
<section
  class="relative flex min-h-screen items-center justify-center overflow-hidden bg-[#0E1620] pt-10"
>
  <!-- Fondo -->
  <div
    class="absolute inset-0 opacity-40"
    aria-hidden="true"
  >
    <div
      class="absolute inset-0"
      style="
        background-image:
          linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
        background-size: 60px 60px;
      "
    ></div>
  </div>

  <!-- Resplandor -->
  <div
    class="absolute left-1/2 top-1/3 h-96 w-96 -translate-x-1/2 rounded-full bg-[#E7D117]/10 blur-3xl"
    aria-hidden="true"
  ></div>

  <!-- Elementos flotantes -->
  <div
    class="hero-scene absolute inset-0 overflow-hidden"
    data-hero-scene
    aria-hidden="true"
  >
    <div
      class="float-ring left-[-5%] top-[5%] h-95 w-95"
      data-parallax
    ></div>

    <div
      class="float-ring bottom-[10%] right-[-3%] h-70 w-70"
      data-parallax
    ></div>

    <div
      class="float-ring right-[15%] top-[20%] h-45 w-45"
      data-parallax
    ></div>

    <div
      class="float-square left-[20%] top-[15%] h-20 w-20"
      data-parallax
      data-rotate="15"
    ></div>

    <div
      class="float-square bottom-[25%] left-[10%] h-12.5 w-12.5"
      data-parallax
      data-rotate="45"
    ></div>

    <div
      class="float-square right-[25%] top-[60%] h-15 w-15"
      data-parallax
      data-rotate="30"
    ></div>

    <div
      class="float-dot left-[40%] top-[30%] h-2 w-2"
      data-parallax
    ></div>

    <div
      class="float-dot bottom-[35%] right-[15%] h-3 w-3"
      data-parallax
    ></div>

    <div
      class="float-dot left-[25%] top-[70%] h-1.5 w-1.5"
      data-parallax
    ></div>

    <div
      class="float-dot right-[35%] top-[10%] h-2.5 w-2.5"
      data-parallax
    ></div>

    <div
      class="particle left-[10%] top-[20%] h-30 w-30"
    ></div>

    <div
      class="particle bottom-[30%] right-[8%] h-20 w-20 [animation-delay:2s]"
    ></div>

    <div
      class="particle left-[70%] top-[50%] h-37.5 w-37.5 [animation-delay:4s]"
    ></div>
  </div>

  <!-- Contenido -->
  <div
    class="relative z-10 mx-auto w-full max-w-6xl px-6 pb-20 pt-32 text-center"
  >
    <div class="mx-auto max-w-4xl">

      <div
        class="mb-6 inline-flex items-center rounded-full border border-[#E7D117]/30 bg-[#E7D117]/5 px-4 py-2 text-sm text-[#F5E98A]"
      >
        <span class="mr-2 h-2 w-2 rounded-full bg-[#E7D117]"></span>

        Servicios de diseño y desarrollo web
      </div>

      <h1
        class="mx-auto max-w-4xl text-5xl font-bold leading-[1.05] tracking-tight md:text-7xl"
      >
        Soluciones digitales
        <span class="text-[#E7D117]"> para hacer crecer</span>
        tu negocio
      </h1>

      <p
        class="mx-auto mt-8 max-w-2xl text-lg leading-8 text-white/65 md:text-xl"
      >
        Desde una landing page hasta una tienda online completa,
        desarrollamos soluciones web adaptadas a los objetivos de tu negocio.
      </p>

      <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="#servicios-disponibles"
          class="rounded-full bg-[#E7D117] px-7 py-3.5 text-center font-semibold text-[#0E1620] transition hover:bg-[#F3DE4A]"
        >
          Ver servicios
        </a>

        <a
          href="/contacto/"
          class="rounded-full border border-[#E7D117]/50 px-7 py-3.5 text-center font-semibold text-[#E7D117] transition hover:bg-[#E7D117]/10"
        >
          Solicitar cotización
        </a>
      </div>

      <div
        class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm text-white/50"
      >
        <span>✓ Diseño personalizado</span>
        <span>✓ Responsive</span>
        <span>✓ SEO básico</span>
        <span>✓ Soluciones escalables</span>
      </div>

    </div>
  </div>
</section>

<style>
  .float-ring,
  .float-square,
  .float-dot {
    pointer-events: none;
    position: absolute;
    transition: transform 0.08s ease-out;
    will-change: transform;
  }

  .float-ring {
    border: 1px solid rgb(231 209 23 / 0.15);
    border-radius: 9999px;
  }

  .float-square {
    border: 1px solid rgb(231 209 23 / 0.12);
  }

  .float-dot {
    background: #e7d117;
    border-radius: 9999px;
    opacity: 0.4;
  }

  .particle {
    animation: float-particle 12s ease-in-out infinite;
    background: rgb(231 209 23 / 0.08);
    border-radius: 9999px;
    pointer-events: none;
    position: absolute;
  }

  @keyframes float-particle {
    0%, 100% {
      opacity: 0.3;
      transform: translate(0, 0) scale(1);
    }

    25% {
      opacity: 0.6;
      transform: translate(30px, -40px) scale(1.2);
    }

    50% {
      opacity: 0.4;
      transform: translate(-20px, -80px) scale(0.8);
    }

    75% {
      opacity: 0.7;
      transform: translate(40px, -30px) scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .particle {
      animation: none;
    }

    .float-ring,
    .float-square,
    .float-dot {
      transition: none;
    }
  }
</style>

<script>
  const scene = document.querySelector<HTMLElement>("[data-hero-scene]");
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  );

  if (scene && !reducedMotion.matches) {
    const elements = Array.from(
      scene.querySelectorAll<HTMLElement>("[data-parallax]")
    );

    const factors = [
      { x: 0.04, y: 0.04 },
      { x: -0.03, y: 0.05 },
      { x: 0.05, y: -0.03 },
      { x: -0.02, y: 0.06 },
      { x: 0.06, y: -0.02 },
      { x: -0.04, y: -0.04 },
      { x: 0.03, y: -0.05 },
      { x: -0.05, y: 0.03 },
      { x: 0.07, y: 0.02 },
      { x: -0.02, y: -0.06 },
    ];

    let animationFrame: number | undefined;

    const moveElements = (
      clientX: number,
      clientY: number
    ) => {
      if (animationFrame) return;

      animationFrame = requestAnimationFrame(() => {
        const x =
          (clientX / window.innerWidth - 0.5) * 2;

        const y =
          (clientY / window.innerHeight - 0.5) * 2;

        elements.forEach((element, index) => {
          const factor = factors[index];
          const rotation =
            element.dataset.rotate ?? "0";

          element.style.transform = `
            translate(
              ${x * factor.x * 60}px,
              ${y * factor.y * 60}px
            )
            rotate(${rotation}deg)
            rotateX(${y * 2}deg)
            rotateY(${x * 2}deg)
          `;
        });

        animationFrame = undefined;
      });
    };

    const resetElements = () => {
      elements.forEach((element) => {
        element.style.transitionDuration = "0.6s";

        element.style.transform = `
          translate(0, 0)
          rotate(${element.dataset.rotate ?? "0"}deg)
        `;
      });
    };

    scene.addEventListener("pointermove", (event) => {
      elements.forEach((element) => {
        element.style.transitionDuration = "0.08s";
      });

      moveElements(event.clientX, event.clientY);
    });

    scene.addEventListener("pointerleave", resetElements);
  }
</script>

    <!-- Services -->
    <section id="servicios-disponibles" class="bg-[#FAFBFC] py-24 text-[#0E1620]">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid gap-6 lg:grid-cols-3">
          {
            services.map((service) => (
              <article class="flex flex-col rounded-3xl border border-[#0E1620]/10 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-2 hover:shadow-xl">
                <span class="text-sm font-semibold tracking-widest text-[#C5A900]">
                  {service.number}
                </span>

                <h2 class="mt-5 text-3xl font-bold">
                  {service.title}
                </h2>

                <p class="mt-4 leading-7 text-[#0E1620]/60">
                  {service.description}
                </p>

                <div class="mt-7 rounded-2xl bg-[#0E1620] p-5 text-white">
                  <p class="text-xs uppercase tracking-wider text-white/40">
                    Inversión
                  </p>

                  <p class="mt-1 text-2xl font-bold text-[#E7D117]">
                    {service.price}
                  </p>
                </div>

                <div class="mt-7">
                  <p class="text-sm font-semibold">
                    Ideal para
                  </p>

                  <p class="mt-2 text-sm leading-6 text-[#0E1620]/55">
                    {service.idealFor}
                  </p>
                </div>

                <div class="my-7 h-px bg-[#0E1620]/10"></div>

                <ul class="space-y-3">
                  {
                    service.features.map((feature) => (
                      <li class="flex items-center gap-3 text-sm text-[#0E1620]/70">
                        <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#E7D117] text-xs font-bold">
                          ✓
                        </span>

                        {feature}
                      </li>
                    ))
                  }
                </ul>

                <a
                  href="/contacto/"
                  class="mt-8 inline-flex justify-center rounded-full bg-[#0E1620] px-6 py-3 font-semibold text-white transition hover:bg-[#E7D117] hover:text-[#0E1620]"
                >
                  Solicitar cotización
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Custom development -->
    <section class="bg-[#0E1620] py-24">
      <div class="mx-auto max-w-7xl px-6">
        <div class="rounded-[2rem] border border-white/10 bg-[#19232F] p-8 md:p-12">
          <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
            <div>
              <span class="text-sm font-medium text-[#E7D117]">
                Desarrollo personalizado
              </span>

              <h2 class="mt-4 text-4xl font-bold tracking-tight md:text-5xl">
                ¿Tu proyecto necesita
                <span class="text-[#E7D117]"> algo diferente?</span>
              </h2>

              <p class="mt-6 max-w-xl leading-8 text-white/55">
                No todos los negocios necesitan una solución estándar.
                Podemos desarrollar funcionalidades específicas e
                integraciones adaptadas a las necesidades de tu proyecto.
              </p>

              <a
                href="/contacto/"
                class="mt-8 inline-flex rounded-full bg-[#E7D117] px-6 py-3.5 font-semibold text-[#0E1620] transition hover:bg-[#F3DE4A]"
              >
                Cuéntame tu proyecto
              </a>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              {
                [
                  "Integraciones",
                  "Formularios avanzados",
                  "Automatizaciones",
                  "Sistemas personalizados",
                  "APIs",
                  "Funcionalidades a medida",
                ].map((item) => (
                  <div class="rounded-2xl border border-white/10 bg-[#0E1620] p-5">
                    <span class="text-[#E7D117]">✦</span>

                    <p class="mt-3 font-medium text-white">
                      {item}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="bg-[#FAFBFC] py-24 text-[#0E1620]">
      <div class="mx-auto max-w-5xl px-6">
        <div class="mx-auto max-w-2xl text-center">
          <span
            class="inline-flex rounded-full border border-[#E7D117] bg-[#E7D117]/10 px-4 py-2 text-sm font-medium"
          >
            Proceso
          </span>

          <h2 class="mt-6 text-4xl font-bold tracking-tight md:text-5xl">
            De la idea
            <span class="text-[#C5A900]"> al proyecto</span>
          </h2>

          <p class="mt-6 text-lg leading-8 text-[#0E1620]/60">
            Un proceso sencillo y transparente para que siempre sepas
            qué está pasando con tu proyecto.
          </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-4">
          {
            [
              {
                number: "01",
                title: "Hablamos",
                text: "Conocemos tu negocio, tus objetivos y lo que necesitas.",
              },
              {
                number: "02",
                title: "Planeamos",
                text: "Definimos alcance, estructura, funcionalidades e inversión.",
              },
              {
                number: "03",
                title: "Desarrollamos",
                text: "Diseño y desarrollo del proyecto con comunicación constante.",
              },
              {
                number: "04",
                title: "Publicamos",
                text: "Revisamos el resultado final y ponemos tu sitio en producción.",
              },
            ].map((step) => (
              <article class="rounded-2xl border border-[#0E1620]/10 bg-white p-6">
                <span class="text-sm font-bold text-[#C5A900]">
                  {step.number}
                </span>

                <h3 class="mt-4 text-xl font-bold">
                  {step.title}
                </h3>

                <p class="mt-3 text-sm leading-6 text-[#0E1620]/55">
                  {step.text}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[#E7D117] py-20 text-[#0E1620]">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl">
          ¿Listo para construir tu sitio?
        </h2>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-[#0E1620]/65">
          Cuéntame qué tienes en mente y podemos definir juntos la mejor
          solución para tu negocio.
        </p>

        <a
          href="/contacto/"
          class="mt-8 inline-flex rounded-full bg-[#0E1620] px-7 py-3.5 font-semibold text-white transition hover:bg-[#19232F]"
        >
          Solicitar cotización
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>